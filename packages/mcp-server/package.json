{
  "name": "@hero/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev:stdio": "tsx watch src/stdio.ts",
    "dev:http": "tsx watch src/http.ts",
    "build": "tsc -p tsconfig.json",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hero/agent": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "fastify": "5.11.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
